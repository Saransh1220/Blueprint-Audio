{
  "name": "waveyard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "prettier:fix": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "biome:lint": "biome lint src",
    "biome:check": "biome check --write"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.6.0",
    "@angular/animations": "^22.2.6",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@lucasmarkes/hairline": "^0.5.1",
    "chart.js": "^4.6.1",
    "ng2-charts": "^11.0.0",
    "prettier": "^3.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-isokit": "^0.6.0",
    "rxjs": "~7.8.2",
    "three": "^0.187.0",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.6",
    "@biomejs/biome": "2.6.7",
    "@types/jasmine": "~7.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "baseline-browser-mapping": "^2.11.36",
    "jasmine-core": "~7.0.2",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  }
}
